# Secrets and OAuth tokens live in this ignored JSON file; see secrets.example.json.
APP_SECRETS_PATH=secrets.json
# POST publishes immediately to TikTok. DRAFT uploads a TikTok draft for manual editing/publication.
# Threads always publishes immediately when configured.
TIKTOK_MODE=POST
# Single persistent FIFO master limiter: rolling cap, spacing, and global cooldown after TikTok limit errors.
REPOST_MAX_MESSAGES_PER_24_HOURS=36
REPOST_MIN_INTERVAL_MINUTES=20
TIKTOK_DAILY_LIMIT_COOLDOWN_HOURS=8
# Caps Drive downloads and every destination on VM.Standard.E2.1.Micro. TikTok's API maximum is 35.
REPOST_MAX_PHOTO_COUNT=10
# Temporarily disabled. Set to true only after connecting the Threads account.
THREADS_ENABLED=false
PORT=8383
MEDIA_DIRECTORY=/var/www/rieltor/media
# Parent Telegram forum chat and its messageThreadId values, stored separately.
# Leave TELEGRAM_MONITORED_MESSAGE_THREAD_IDS empty to monitor the whole chat.
TELEGRAM_MONITORED_CHAT_ID=-1002681732909
TELEGRAM_MONITORED_MESSAGE_THREAD_IDS=5242880,4194304
