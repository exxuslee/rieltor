# Always read from the process environment or .env; never stored in SQLite.
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
# The settings below are imported into data/rieltor.db only when missing.
TIKTOK_REDIRECT_URI=https://api.rieltor.dpdns.org/auth/tiktok/callback
# Read on every startup; selects data/telegram/tdlib-session-id<TELEGRAM_USER_ID>.
TELEGRAM_USER_ID=530667123
PUBLIC_BASE_URL=https://api.rieltor.dpdns.org
PORT=8383
# Parent Telegram chat IDs to monitor, separated by commas.
TELEGRAM_MONITORED_CHANNEL_IDS=-1002681732909
# Optional forum topic root message IDs to monitor, separated by commas. Leave empty to monitor every topic.
TELEGRAM_MONITORED_TOPIC_IDS=1,2,3
