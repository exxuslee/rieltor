# Always read from the process environment or .env; never stored in SQLite.
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
# The settings below are imported into rieltor.db only when missing.
TIKTOK_REDIRECT_URI=https://api.rieltor.dpdns.org/auth/tiktok/callback
# POST publishes immediately to TikTok. DRAFT uploads a TikTok draft for manual editing/publication.
# Threads always publishes immediately when configured.
TIKTOK_MODE=POST
# Caps Drive downloads and every destination on VM.Standard.E2.1.Micro. TikTok's API maximum is 35.
REPOST_MAX_PHOTO_COUNT=10
# Meta Threads app. App credentials stay in environment/.env; the long-lived user token is stored in SQLite.
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
THREADS_REDIRECT_URI=https://api.rieltor.dpdns.org/auth/threads/callback
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# Google OAuth web application. Client credentials stay in environment/.env; tokens are stored in SQLite.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://api.rieltor.dpdns.org/auth/google/callback
# Environment-only. Read on every startup; selects tdlib-session-id<TELEGRAM_USER_ID> beside the JAR.
TELEGRAM_USER_ID=530667123
PUBLIC_BASE_URL=https://api.rieltor.dpdns.org
PORT=8383
MEDIA_DIRECTORY=/var/www/rieltor/media
# Parent Telegram forum chat and its messageThreadId values, stored separately.
# Leave TELEGRAM_MONITORED_MESSAGE_THREAD_IDS empty to monitor the whole chat.
TELEGRAM_MONITORED_CHAT_ID=-1002681732909
TELEGRAM_MONITORED_MESSAGE_THREAD_IDS=5242880,4194304
