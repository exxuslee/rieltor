limit_req_zone $binary_remote_addr zone=rieltor_api_per_ip:10m rate=10r/s;

# The API has a very small public surface. Reject every URI that is not an actual application route.
map $uri $rieltor_route_allowed {
    default 0;
    "/" 1;
    "/health" 1;
    ~^/auth/tiktok/(?:login|callback)$ 1;
    ~^/auth/google/(?:login|callback)$ 1;
    ~^/auth/threads/(?:login|callback)$ 1;
    "~^/media/[0-9a-fA-F-]{36}\.(?:jpg|jpeg|png|webp)$" 1;
    ~^/tiktok[A-Za-z0-9]+\.txt$ 1;
    ~^/\.well-known/acme-challenge/[A-Za-z0-9_-]+$ 1;
}

server {
    listen 80;
    server_name api.rieltor.dpdns.org;
    server_tokens off;

    if ($rieltor_route_allowed = 0) {
        return 444;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name api.rieltor.dpdns.org;
    server_tokens off;

    if ($rieltor_route_allowed = 0) {
        return 444;
    }

    ssl_certificate /etc/letsencrypt/live/api.rieltor.dpdns.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.rieltor.dpdns.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    location / {
        limit_req zone=rieltor_api_per_ip burst=30 nodelay;
        proxy_pass http://127.0.0.1:8383;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
